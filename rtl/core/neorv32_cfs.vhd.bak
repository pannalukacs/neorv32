-- ================================================================================ --
-- NEORV32 SoC - Custom Functions Subsystem (CFS)                                   --
-- -------------------------------------------------------------------------------- --
-- Kyber Montgomery-Reduce example (Multi-cycle implementation)                      --
-- Write operand 'a' (32 bit) to REG[0]; read REG[1] for status (0=ready, 1=busy)  --
-- Read REG[0] back to obtain montgomery_reduce(a) in the lower 16 bits            --
-- -------------------------------------------------------------------------------- --
-- The NEORV32 RISC-V Processor - https://github.com/stnolting/neorv32              --
-- Copyright (c) NEORV32 contributors.                                              --
-- Copyright (c) 2020 - 2025 Stephan Nolting. All rights reserved.                  --
-- Licensed under the BSD-3-Clause license, see LICENSE for details.                --
-- SPDX-License-Identifier: BSD-3-Clause                                            --
-- ================================================================================ --

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

library neorv32;
use neorv32.neorv32_package.all;

entity neorv32_cfs is
  generic (
    CFS_CONFIG   : std_ulogic_vector(31 downto 0); -- custom CFS configuration generic
    CFS_IN_SIZE  : natural;                        -- size of CFS input conduit in bits
    CFS_OUT_SIZE : natural                         -- size of CFS output conduit in bits
  );
  port (
    clk_i       : in  std_ulogic; -- global clock line
    rstn_i      : in  std_ulogic; -- global reset line, low-active, use as async
    bus_req_i   : in  bus_req_t;  -- bus request
    bus_rsp_o   : out bus_rsp_t;  -- bus response
    clkgen_en_o : out std_ulogic; -- enable clock generator
    clkgen_i    : in  std_ulogic_vector(7 downto 0); -- derived clock enables
    irq_o       : out std_ulogic; -- interrupt request
    cfs_in_i    : in  std_ulogic_vector(CFS_IN_SIZE-1 downto 0); -- custom inputs
    cfs_out_o   : out std_ulogic_vector(CFS_OUT_SIZE-1 downto 0) -- custom outputs
  );
end neorv32_cfs;

-- ################################################################################################
architecture neorv32_cfs_rtl of neorv32_cfs is
-- ################################################################################################

  -- --------------------------------------------------------------------------
  -- Interface register file (WRITE side & READ side)
  -- --------------------------------------------------------------------------
  type cfs_regs_t is array (0 to 3) of std_ulogic_vector(31 downto 0);
  signal cfs_reg_wr : cfs_regs_t := (others => (others => '0'));
  signal cfs_reg_rd : cfs_regs_t;

  -- --------------------------------------------------------------------------
  -- Constants for Kyber q = 3329
  -- --------------------------------------------------------------------------
  constant KYBER_Q : signed(15 downto 0) := to_signed(3329, 16);
  constant QINV    : signed(15 downto 0) := to_signed(-3327, 16); -- 3329^(-1) mod 2^16

  -- --------------------------------------------------------------------------
  -- Montgomery reduction state machine
  -- --------------------------------------------------------------------------
  type state_t is (IDLE, CYCLE1_MULT, CYCLE2_MULT, CYCLE3_SUB_SHIFT);
  signal state      : state_t;
  signal next_state : state_t;
  
  -- Internal registers for multi-cycle computation
  signal a_reg      : signed(31 downto 0);  -- Input operand storage
  signal t0_reg     : signed(31 downto 0);  -- Result of first multiplication
  signal prod_reg   : signed(31 downto 0);  -- Result of second multiplication
  signal result_reg : signed(15 downto 0);  -- Final result
  signal busy       : std_ulogic;           -- Busy flag
  
  -- Start signal (write to REG[0] triggers computation)
  signal start_op   : std_ulogic;

-- ################################################################################################
begin
-- ################################################################################################

  -- ----------------------------------------------------------------------------
  -- Static outputs (unused features)
  -- ----------------------------------------------------------------------------
  clkgen_en_o <= '0';                 -- no derived clocks required
  irq_o       <= '0';                 -- no interrupt generated
  cfs_out_o   <= (others => '0');     -- conduit unused in this example

  -- ----------------------------------------------------------------------------
  -- Detect write to REG[0] to start operation
  -- ----------------------------------------------------------------------------
  start_op <= '1' when (bus_req_i.stb = '1' and bus_req_i.rw = '1' and 
                        bus_req_i.addr(15 downto 2) = "00000000000000") else '0';

  -- ----------------------------------------------------------------------------
  -- State machine control
  -- ----------------------------------------------------------------------------
  fsm_sync : process(clk_i, rstn_i)
  begin
    if rstn_i = '0' then
      state <= IDLE;
    elsif rising_edge(clk_i) then
      state <= next_state;
    end if;
  end process fsm_sync;

  fsm_comb : process(state, start_op)
  begin
    next_state <= state;
    
    case state is
      when IDLE =>
        if start_op = '1' then
          next_state <= CYCLE1_MULT;
        end if;
        
      when CYCLE1_MULT =>
        next_state <= CYCLE2_MULT;
        
      when CYCLE2_MULT =>
        next_state <= CYCLE3_SUB_SHIFT;
        
      when CYCLE3_SUB_SHIFT =>
        next_state <= IDLE;
        
      when others =>
        next_state <= IDLE;
    end case;
  end process fsm_comb;

  -- Busy flag - should be '1' when operation is starting or in progress
  busy <= '1' when (start_op = '1' or state /= IDLE) else '0';

  -- ----------------------------------------------------------------------------
  -- Montgomery reduction datapath (multi-cycle)
  -- ----------------------------------------------------------------------------
  mont_reduce_proc : process(clk_i, rstn_i)
    variable lo_u : unsigned(15 downto 0);
    variable diff : signed(31 downto 0);
  begin
    if rstn_i = '0' then
      a_reg      <= (others => '0');
      t0_reg     <= (others => '0');
      prod_reg   <= (others => '0');
      result_reg <= (others => '0');
    elsif rising_edge(clk_i) then
      
      case state is
        when IDLE =>
          -- Capture input when starting
          if start_op = '1' then
            a_reg <= signed(bus_req_i.data);
          end if;
          
        when CYCLE1_MULT =>
          -- t0 = (a mod 2^16) * q^(-1)
          lo_u := unsigned(a_reg(15 downto 0));
          t0_reg <= resize(signed(lo_u) * QINV, 32);
          
        when CYCLE2_MULT =>
          -- prod = (t0 mod 2^16) * q
          prod_reg <= resize(signed(t0_reg(15 downto 0)) * KYBER_Q, 32);
          
        when CYCLE3_SUB_SHIFT =>
          -- (a - t0*q) >> 16
          diff := a_reg - prod_reg;
          -- Logical shift right by 16 (zero-extended)
          result_reg <= signed(shift_right(unsigned(diff), 16)(15 downto 0));
          
        when others =>
          null;
      end case;
    end if;
  end process mont_reduce_proc;

  -- ----------------------------------------------------------------------------
  -- Bus interface : read / write handshake
  -- ----------------------------------------------------------------------------
  bus_access : process(clk_i, rstn_i)
  begin
    if rstn_i = '0' then                          -- asynchronous reset (low-active)
      cfs_reg_wr <= (others => (others => '0'));
      bus_rsp_o  <= rsp_terminate_c;              -- default "not ready"
    elsif rising_edge(clk_i) then
      -- default response every cycle
      bus_rsp_o.ack  <= bus_req_i.stb;
      bus_rsp_o.err  <= '0';
      bus_rsp_o.data <= (others => '0');

      if bus_req_i.stb = '1' then                 -- valid transaction
        if bus_req_i.rw = '1' then                -- WRITE
          case bus_req_i.addr(15 downto 2) is
            when "00000000000000" => cfs_reg_wr(0) <= bus_req_i.data;
            when "00000000000001" => cfs_reg_wr(1) <= bus_req_i.data;
            when "00000000000010" => cfs_reg_wr(2) <= bus_req_i.data;
            when "00000000000011" => cfs_reg_wr(3) <= bus_req_i.data;
            when others           => null;
          end case;
        else                                       -- READ
          case bus_req_i.addr(15 downto 2) is
            when "00000000000000" => bus_rsp_o.data <= cfs_reg_rd(0);
            when "00000000000001" => bus_rsp_o.data <= cfs_reg_rd(1);
            when "00000000000010" => bus_rsp_o.data <= cfs_reg_rd(2);
            when "00000000000011" => bus_rsp_o.data <= cfs_reg_rd(3);
            when others           => bus_rsp_o.data <= (others => '0');
          end case;
        end if;
      end if;
    end if;
  end process bus_access;

  -- ----------------------------------------------------------------------------
  -- Register read mapping
  -- ----------------------------------------------------------------------------
  -- REG[0]: Result register (upper 16 bits = 0, lower 16 bits = result)
  cfs_reg_rd(0) <= std_ulogic_vector(to_unsigned(0, 16)) & std_ulogic_vector(result_reg);
  
  -- REG[1]: Status register (bit 0 = busy flag, remaining bits = 0)
  cfs_reg_rd(1) <= (0 => busy, others => '0');
  
  -- Remaining registers read as zero
  cfs_reg_rd(2) <= (others => '0');
  cfs_reg_rd(3) <= (others => '0');

end neorv32_cfs_rtl;